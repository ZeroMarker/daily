{
  "name": "ai-news-daily",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/sync_content.sh && remotion studio",
    "check": "bash scripts/sync_content.sh && tsc --noEmit",
    "fetch": "python3 scripts/fetch.py",
    "voiceover": "python3 scripts/gen_voiceover.py",
    "validate": "python3 scripts/validate_sync.py",
    "render": "bash scripts/render.sh",
    "render:draft": "bash scripts/sync_content.sh && remotion render NewsDaily out/preview.mp4 --scale=0.5 --concurrency=4 --log=error"
  },
  "dependencies": {
    "@remotion/cli": "4.0.504",
    "@remotion/google-fonts": "4.0.504",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.504"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3"
  }
}
