# OpenAI-compatible LLM endpoint for the AI summarization step.
# Copy to .env and fill in real values; .env is gitignored.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# How many news items to include each day (intro + news + outro).
NEWS_COUNT=6

# Edge TTS speaking rate for narration. Natural = +0%, slightly faster = +4%.
TTS_RATE=+4%
